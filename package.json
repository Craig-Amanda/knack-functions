{
    "name": "knack-functions",
    "private": true,
    "type": "module",
    "exports": {
        "./eslint": "./eslint/index.js"
    },
    "files": [
        "eslint/"
    ],
    "scripts": {
        "build": "npm run build:eslint-globals && npm run build:global",
        "build:global": "node builds/copy-global.mjs && terser dist/knackFunctions.global.js -o dist/knackFunctions.global.min.js --compress --mangle",
        "dev": "node server.js",
        "start": "npm run dev",
        "simple": "node simple-server.js",
        "build:eslint-globals": "node eslint/generate-globals.mjs"
    },
    "devDependencies": {
        "acorn": "^8.18.0",
        "chokidar": "3.5.3",
        "cors": "2.8.5",
        "express": "4.18.2",
        "terser": "^5.34.0"
    },
    "dependencies": {
        "@eslint/js": "^9.39.5",
        "globals": "^16.5.0"
    },
    "peerDependencies": {
        "eslint": ">=9"
    },
    "peerDependenciesMeta": {
        "eslint": {
            "optional": true
        }
    }
}
